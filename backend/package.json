{
  "name": "asset-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Pilar Group Asset Management backend",
  "main": "src/server.js",
  "scripts": {
    "dev": "cross-env NODE_ENV=development node --watch src/server.js",
    "start": "cross-env NODE_ENV=production node src/server.js",
    "check": "node scripts/check-js.js",
    "db:migrate": "node scripts/migrate.js",
    "db:seed": "node scripts/seed.js",
    "db:setup": "npm run db:migrate && npm run db:seed",
    "db:bootstrap": "node scripts/bootstrap-admin.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "cross-env": "^7.0.3",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "mysql2": "^3.14.1",
    "xlsx": "^0.18.5"
  }
}
