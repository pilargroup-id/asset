APP_NAME=asset
APP_SLUG=asset
APP_PORT=3000
NODE_ENV=development

# JWT - shared secret with pilargroup
JWT_SECRET=

# Internal Endpoint secret used by Asset when calling PilarGroup directory
INTERNAL_SYNC_SECRET=

# Asset internal API secret - share only with trusted internal systems such as the future Ticket backend
INTERNAL_API_SECRET=

# Pilargroup
PILARGROUP_URL=https://pilargroup.id
PILARGROUP_DIRECTORY_BASE_PATH=/api/internal/directory
AUTH_ME_TIMEOUT_MS=10000
DIRECTORY_TIMEOUT_MS=10000

# CORS
CORS_ORIGIN=http://localhost:5173

# Database Project
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=asset
DB_CONNECTION_LIMIT=10

# Import - XLSX/XLS/CSV binaries are parsed in memory and never persisted.
# Parsed preview/result state is temporary JSON under backend/storage/import-previews and expires automatically.
IMPORT_MAX_FILE_MB=20
IMPORT_PREVIEW_TTL_MINUTES=60

# Implementation default. Can later be moved to database settings if needed.
ALLOW_NEGATIVE_CONSUMABLE_STOCK=false

# Dev auth - auto-login using PilarGroup; token is still fetched from central auth
DEV_AUTH_ENABLED=false
# DEV_AUTH_USERNAME=
# DEV_AUTH_PASSWORD=

# One-time authorization bootstrap. Comma-separated PilarGroup user UUID(s) from /auth/me.id.
# Example: uuid-1,uuid-2. Run `npm run db:bootstrap`, then remove/blank it again.
BOOTSTRAP_ADMIN_USER_IDS=
